{{!
    @template message_telegrambot/preferences

    Telegram chat of the user, in the notification preferences.

    Example context (json):
    {
        "chatid": "-1001234567890",
        "configured": true
    }
}}
<div class="message_telegrambot-preferences">
    {{^configured}}
    <div class="alert alert-warning">{{#str}} notconfigured, message_telegrambot {{/str}}</div>
    {{/configured}}
    <label for="message_telegrambot_chatid">{{#str}} chatid, message_telegrambot {{/str}}</label>
    <input type="text" class="form-control" id="message_telegrambot_chatid" name="telegrambot_chatid" value="{{chatid}}" size="30">
    <div class="form-text text-muted">{{#str}} chatid_help, message_telegrambot {{/str}}</div>
</div>
